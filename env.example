# Vercel Environment Variables
# Set these in Vercel > Project > Settings > Environment Variables.
# Do not commit real credentials into Git.

LAZADA_APP_KEY=YOUR_LAZADA_LITEAPP_KEY
LAZADA_APP_SECRET=YOUR_NEW_LAZADA_LITEAPP_SECRET
LAZADA_USER_TOKEN=YOUR_NEW_LAZADA_USER_TOKEN

# Optional settings
LAZADA_BASE_URL=https://api.lazada.vn
LAZADA_API_PATH=/marketing/getlink
LAZADA_PARTNER_ID=lazop-sdk-php-affiliate-1.0
